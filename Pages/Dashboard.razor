@page "/dashboard"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager NavManager
@inject CustomAuthStateProvider AuthProvider
@inject IJSRuntime JS

<h3>Dashboard</h3>

<button @onclick="Logout" class="btn btn-danger">Logout</button>

@code {
    protected override void OnInitialized()
    {
        // Redirect unauthorized users to login
        var authStateTask = AuthProvider.GetAuthenticationStateAsync();
        authStateTask.ContinueWith(t =>
        {
            var user = t.Result.User;
            if (!user.Identity?.IsAuthenticated ?? true)
            {
                NavManager.NavigateTo("/", true);
            }
        });
    }

    private async Task Logout()
    {
        // Call Firebase sign-out JS function
        await JS.InvokeVoidAsync("signOutFirebase");

        // Update Blazor authentication state
        AuthProvider.NotifyUserChanged(null);

        // Redirect to login
        NavManager.NavigateTo("/", true);
    }
}
