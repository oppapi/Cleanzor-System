            <div class="header">
                <i class='bx bx-menu menu-icon' @onclick="ToggleSidebar"></i>
                <span>Dashboard</span>
            </div>

            <div class="main-content">
        <div class="info">

        <!-- Status Box -->
        <div class="small-box" style="background-color: #4db6ac; color: #ffffff;">
            <div class="inner">
                <h3>@(status)</h3>
                <p>Status</p>
            </div>
            <img src="images/status.svg" alt="Status Icon" class="small-box-icon" style="width: 70px; height: auto; filter: brightness(0) invert(1);" />
            <div class="small-box-footer" style="height: 7px;"></div>
        </div>

        <!-- Load Box -->
        <div class="small-box" style="background-color: #4db6ac; color: #ffffff;">
            <div class="inner">
                <h3>@(uptime)</h3>
                <p>Uptime</p>
            </div>
            <img src="images/uptime.svg" alt="Load Icon" class="small-box-icon" style="width: 60px; height: auto; filter: brightness(0) invert(1);" />
            <div class="small-box-footer" style="height: 7px;"></div>
        </div>

        <!-- Schedule Box -->
        <div class="small-box" style="background-color: #4db6ac; color: #ffffff;">
            <div class="inner">
                <h3>@(location)</h3>
                <p>Location</p>
            </div>
            <img src="images/location.svg" alt="Schedule Icon" class="small-box-icon" style="width: 70px; height: auto; filter: brightness(0) invert(1);" />
            <div class="small-box-footer" style="height: 7px;"></div>
        </div>

        <!-- Battery Box -->
        <div class="small-box" style="background-color: #4db6ac; color: #ffffff;">
            <div class="inner">
                <h3>@(battery)</h3>
                <p>Battery</p>
            </div>
            <img src="images/battery.svg" alt="Battery Icon" class="small-box-icon" style="width: 70px; height: auto; filter: brightness(0) invert(1);" />
            <div class="small-box-footer" style="height: 7px;"></div>
        </div>

        <!-- Wheel Speed Box -->
        <div class="small-box" style="background-color: #4db6ac; color: #ffffff;">
            <div class="inner">
                <h3>@(temperature)</h3>
                <p>Temperature</p>
            </div>
            <img src="images/temperature.svg" alt="Wheel Icon" class="small-box-icon" style="width: 70px; height: auto; filter: brightness(0) invert(1);" />
            <div class="small-box-footer" style="height: 7px;"></div>
        </div>

        <!-- Sweeper Speed Box -->
        <!-- Time Box -->
        <div class="small-box" style="background-color: #4db6ac; color: #ffffff;">
            <div class="inner">
                <h3>@currentTime</h3>
                <p>@currentDate</p>
            </div>
            <img src="images/datetime.svg" alt="Sweeper Icon" class="small-box-icon" 
                style="width: 70px; height: auto; filter: brightness(0) invert(1);" />
            <div class="small-box-footer" style="height: 7px;"></div>
        </div>

        </div>
            <div class="card">
                <div class="area-chart">
                    <div class="grid"></div>
                </div>
            </div>
            <div class="pie-graph" id="pieChartContainer"></div>
            </div>
            
            </div>
        </section>
    </div>

    @if (isLoading)
    {
        <div class="loading-overlay">
            <div class="loader">
                CLEANZOR LOADING...
            </div>
        </div>
    }


@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@code {
    [Inject] NavigationManager NavManager { get; set; } = default!;
    
    // State properties
    private bool isLoading { get; set; } = false;
    private string status = "Loading...";
    private string uptime = "Loading...";
    private string location = "Loading...";
    private string battery = "Loading...";
    private string temperature = "Loading...";
    private string time = "Loading...";

    private bool isSidebarOpen = false;
    private bool isDarkMode = false;
    private bool chartsLoaded = false; 

    private string currentTime = DateTime.Now.ToString("hh:mm:ss tt");
    private string currentDate = DateTime.Now.ToString("MMM dd, yyyy");

    // CancellationTokenSource for background tasks
    private CancellationTokenSource cts = new CancellationTokenSource();


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !chartsLoaded)
        {
            await LoadCharts();
            chartsLoaded = true;
            
            // Only call JS listener once
            await JSRuntime.InvokeVoidAsync("listenToSensorData"); 

            // Start the periodic tasks
            _ = PeriodicUpdate(cts.Token);
            _ = UpdateClock(cts.Token);
        }
    }

    // Dispose of background tasks when the component is removed
    public void Dispose()
    {
        cts.Cancel();
    }


    // --- UI/Component Methods ---

    private async Task LoadCharts()
    {
        await JSRuntime.InvokeVoidAsync("loadCharts", isDarkMode);
    }
    
    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
        // Call StateHasChanged if this affects the rendered UI
        StateHasChanged(); 
    }

    private void OpenSidebar()
    {
        isSidebarOpen = true;
        // Call StateHasChanged if this affects the rendered UI
        StateHasChanged();
    }

    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        await JSRuntime.InvokeVoidAsync("toggleDarkMode", isDarkMode);
        await JSRuntime.InvokeVoidAsync("updateChartColors", isDarkMode);
        StateHasChanged(); // Ensure UI reflects the new dark mode setting
    }

    private async Task Signout()
    {
        isLoading = true;
        StateHasChanged();
        await ShowLoadingAndRedirect("/", 1000);
    }

    private async Task ShowLoadingAndRedirect(string url, int delayMs)
    {
        await Task.Delay(delayMs);
        isLoading = false;
        StateHasChanged();
        NavManager.NavigateTo(url);
    }
    private async Task ShowLoadingAndRedirect(string url)
    {
        // Note: Since isLoading is set to false immediately, the loading screen will flash if it was true.
        // It's generally best to keep the delay version if a transition is needed.
        isLoading = false;
        StateHasChanged();
        NavManager.NavigateTo(url);
    }

    // --- Periodic Tasks ---

    private async Task PeriodicUpdate(CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            try
            {
                // Retrieve data from localStorage
                var dataJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "robotData");

                if (!string.IsNullOrEmpty(dataJson))
                {
                    var parsed = System.Text.Json.JsonDocument.Parse(dataJson).RootElement;

                    // Ensure ALL state updates happen before StateHasChanged is called.
                    // Use InvokeAsync to marshal the state update back to the UI thread.
                    await InvokeAsync(() =>
                    {
                        status = parsed.TryGetProperty("status", out var s) ? s.ToString() : status;
                        uptime = parsed.TryGetProperty("uptime", out var up) ? up.ToString() : uptime;
                        location = parsed.TryGetProperty("location", out var loc) ? loc.ToString() : location;
                        battery = parsed.TryGetProperty("battery", out var b) ? b.ToString() : battery;
                        temperature = parsed.TryGetProperty("temperature", out var temp) ? temp.ToString() : temperature;
                        time = parsed.TryGetProperty("time", out var t) ? t.ToString() : time;
                        
                        // Call StateHasChanged after all properties are updated.
                        StateHasChanged();
                    });
                }
                else
                {
                    Console.WriteLine("No robotData found in localStorage.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error reading sensor data: {ex.Message}");
            }

            // Wait 2 seconds before checking again
            await Task.Delay(2000, token);
        }
    }

    private async Task UpdateClock(CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            currentTime = DateTime.Now.ToString("hh:mm:ss tt");
            currentDate = DateTime.Now.ToString("MMM dd, yyyy");

            await InvokeAsync(StateHasChanged);
            await Task.Delay(1000, token);
        }
    }
}

    <script>
        function toggleDarkMode(isDark) {
            if (isDark) {
                document.body.classList.add('dark');
            } else {
                document.body.classList.remove('dark');
            }
        }
    </script>

