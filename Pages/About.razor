@page "/about"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject CustomAuthStateProvider AuthProvider
@inject IJSRuntime JSRuntime

<div class="page-container">
    <nav class="sidebar @(isSidebarOpen ? "" : "close")">
        <header>
            <div class="image-text">
                <span class="image">
                    <img src="images/CleanzorGreenLogo.png" alt="Cleanzor-Logo">
                </span>

                <div class="text logo-text">
                    <span class="name">Stella Army</span>
                    <span class="profession">Web developer</span>
                </div>
            </div>

            <i class='bx bx-chevron-right toggle' @onclick="ToggleSidebar"></i>
        </header>

        <div class="menu-bar">
            <div class="menu">
                <ul class="menu-links">
                    <li class="nav-link">
                        <a href="/dashboard">
                            <i class='bx bx-home-alt icon'></i>
                            <span class="text nav-text">Dashboard</span>
                        </a>
                    </li>

                    <li class="nav-link">
                        <a href="/profile">
                            <i class='bx bx-bar-chart-alt-2 icon'></i>
                            <span class="text nav-text">Profile</span>
                        </a>
                    </li>

                    <li class="nav-link">
                        <a href="/about">
                            <i class='bx bx-bell icon'></i>
                            <span class="text nav-text">About Us</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="bottom-content">
                <li class="">
                    <a>
                        <i class='bx bx-log-out icon'></i>
                        <span class="text nav-text" @onclick="Signout">Logout</span>
                    </a>
                </li>

                <li class="mode">
                    <div class="sun-moon">
                        <i class='bx bx-moon icon moon'></i>
                        <i class='bx bx-sun icon sun'></i>
                    </div>
                    <span class="mode-text text">@(isDarkMode ? "Light mode" : "Dark mode")</span>

                    <div class="toggle-switch" @onclick="ToggleDarkMode">
                        <span class="switch"></span>
                    </div>
                </li>
            </div>
        </div>
    </nav>
    
    <section class="home">
        <div class="main-content">
            <div class="about-card">
                
                <h3 class="about-title">About Us</h3>
                <p class="about-description">
                    Welcome to Cleanzor, your trusted partner in professional cleaning services. We are a family-owned business dedicated to providing top-notch cleaning solutions for homes and offices. Our team of experienced professionals uses eco-friendly products and state-of-the-art equipment to ensure a spotless and healthy environment. At Cleanzor, we believe in building lasting relationships with our clients by delivering exceptional service with a personal touch. Whether it's a one-time deep clean or regular maintenance, we're here to make your space shine.
                </p>
                
                <div class="about-details">
                    <div class="detail-section">
                        <h4>Our Mission</h4>
                        <p>To create cleaner, healthier spaces while fostering a positive impact on our community and the environment.</p>
                    </div>
                    <div class="detail-section">
                        <h4>Our Values</h4>
                        <p>Integrity, excellence, sustainability, and customer satisfaction are at the core of everything we do.</p>
                    </div>
                    <div class="detail-section">
                        <h4>Contact Us</h4>
                        <p>Email: info@cleanzor.com | Phone: (123) 456-7890</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    [Inject] NavigationManager NavManager { get; set; } = default!;

    private bool isSidebarOpen = false;
    private bool isDarkMode = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

    }

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private void OpenSidebar()
    {
        isSidebarOpen = true;
    }

    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        await JSRuntime.InvokeVoidAsync("toggleDarkMode", isDarkMode);
    }

    private async Task Signout()
    {
        NavManager.NavigateTo("/");
    }
}

<script>
    function toggleDarkMode(isDark) {
        if (isDark) {
            document.body.classList.add('dark');
        } else {
            document.body.classList.remove('dark');
        }
    }
</script>

<style>
    @@import url('https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css');

:root {
    --body-color: #e4e9f7;
    --sidebar-color: #fff;
    --primary-color: #dc143c;
    --primary-color-light: #f6f5ff;
    --toggle-color: #ddd;
    --text-color: #707070;

    --tran-02: all 0.2s ease;
    --tran-03: all 0.3s ease;
    --tran-04: all 0.4s ease;
    --tran-05: all 0.5s ease;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    height: 100vh;
    display: grid;
    place-items: center;
    /* Overlay for the lower half of the background image */
    background: 
        linear-gradient(to bottom, transparent 50%, rgba(228, 233, 247, 1) 50%), 
        url("images/BlueGreenBackground.png");
    background-size: cover; 
    font-family: "Montserrat", sans-serif;
    background-color: var(--body-color);
    transition: var(--tran-05);
}

.about-logo {
    /* Positioning the logo relative to the card */
    width: 100%;
    max-width: 600px; /* Wider for landscape */
    height: 300px; /* Taller for bigger size */
    border-radius: 20px; /* Rounded rectangle */
    background-color: var(--sidebar-color); 
    border: 5px solid var(--sidebar-color);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    padding: 5px; 
    margin-bottom: 20px;
    overflow: hidden; /* Ensure image fits within rounded corners */
}

.about-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Cover to maintain aspect ratio */
    border-radius: 15px; /* Slightly less to fit inside padding */
}

::selection {
    background-color: var(--primary-color);
    color: #fff;
}

body.dark {
    --body-color: #18191a;
    --sidebar-color: #242526;
    --primary-color: #3a3b3c;
    --primary-color-light: #3a3b3c;
    --toggle-color: #fff;
    --text-color: #ccc;
}

body.dark .sidebar li a:hover .icon,
body.dark .sidebar li a:hover .text {
    color: var(--text-color);
}

.page-container {
    height: 100vh;
    width: 100%;
    overflow: hidden;
}

/* -------------------- MAIN CONTENT & ABOUT CARD STYLES -------------------- */

.main-content {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 25px; 
    overflow-y: auto; 
    width: 100%;
    height: 100%;
}

.about-card {
    width: 95%;
    max-width: 1400px;
    min-height: 600px;
    height: 85%;
    background-color: var(--sidebar-color);
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    padding: 40px;
    box-sizing: border-box;
    transition: var(--tran-05);
    color: var(--text-color);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.about-card .about-title {
    font-size: 36px;
    font-weight: bolder;
    margin-bottom: 20px;
}

.about-card .about-description {
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 30px;
    max-width: 800px;
}

.about-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    width: 100%;
    max-width: 1000px;
}

.detail-section h4 {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 10px;
    color: var(--primary-color);
}

.detail-section p {
    font-size: 16px;
    line-height: 1.5;
}

/* -------------------- END MAIN CONTENT & ABOUT CARD STYLES -------------------- */

.sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100%;
    width: 250px;
    padding: 10px 14px;
    background: var(--sidebar-color);
    transition: var(--tran-05);
    z-index: 100;
}

.sidebar.close {
    width: 88px;
}

.sidebar.close:hover {
    width: 250px;
}

.sidebar.close:hover .text {
    opacity: 1;
}

.sidebar li {
    height: 50px;
    list-style: none;
    display: flex;
    align-items: center;
    margin-top: 10px;
}

.sidebar header .image,
.sidebar .icon {
    min-width: 60px;
    border-radius: 6px;
}

.sidebar .icon {
    min-width: 60px;
    border-radius: 6px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
}

.sidebar .text,
.sidebar .icon {
    color: var(--text-color);
    transition: var(--tran-03);
}

.sidebar .text {
    font-size: 17px;
    font-weight: 500;
    white-space: nowrap;
    opacity: 1;
}
.sidebar.close .text {
    opacity: 0;
}

.sidebar header {
    position: relative;
}

.sidebar header .image-text {
    display: flex;
    align-items: center;
}
.sidebar header .logo-text {
    display: flex;
    flex-direction: column;
}
header .image-text .name {
    margin-top: 2px;
    font-size: 18px;
    font-weight: 600;
}

header .image-text .profession {
    font-size: 16px;
    margin-top: -2px;
    display: block;
}

.sidebar header .image {
    display: flex;
    align-items: center;
    justify-content: center;
}

.sidebar header .image img {
    width: 40px;
    border-radius: 6px;
}

.sidebar header .toggle {
    position: absolute;
    top: 50%;
    right: -30px;
    transform: translateY(-50%) rotate(180deg);
    height: 25px;
    width: 25px;
    background-color: var(--primary-color);
    color: var(--sidebar-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    cursor: pointer;
    transition: var(--tran-05);
}

body.dark .sidebar header .toggle {
    color: var(--text-color);
}

.sidebar.close .toggle {
    transform: translateY(-50%) rotate(0deg);
}

@@media (min-width: 1101px) {
    .sidebar header .toggle {
        display: none;
    }
}

.sidebar .menu {
    margin-top: 40px;
}

.sidebar li.search-box {
    border-radius: 6px;
    background-color: var(--primary-color-light);
    cursor: pointer;
    transition: var(--tran-05);
}

.sidebar li.search-box input {
    height: 100%;
    width: 100%;
    outline: none;
    border: none;
    background-color: var(--primary-color-light);
    color: var(--text-color);
    border-radius: 6px;
    font-size: 17px;
    font-weight: 500;
    transition: var(--tran-05);
}

.menu-links {
    padding: 0;
    margin: 0;
    list-style: none;
}

.sidebar li a {
    list-style: none;
    height: 100%;
    background-color: transparent;
    display: flex;
    align-items: center;
    width: 100%;
    border-radius: 6px;
    text-decoration: none;
    transition: var(--tran-03);
}

.sidebar li a:hover {
    background-color: #00a887;
}
.sidebar li a:hover .icon,
.sidebar li a:hover .text {
    color: var(--sidebar-color);
}

.sidebar .menu-bar {
    height: calc(100% - 55px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow-y: scroll;
}
.menu-bar::-webkit-scrollbar {
    display: none;
}
.sidebar .menu-bar .mode {
    border-radius: 6px;
    background-color: var(--primary-color-light);
    position: relative;
    transition: var(--tran-05);
}

.menu-bar .mode .sun-moon {
    height: 50px;
    width: 60px;
}

.mode .sun-moon i {
    position: absolute;
}
.mode .sun-moon i.sun {
    opacity: 0;
}
body.dark .mode .sun-moon i.sun {
    opacity: 1;
}
body.dark .mode .sun-moon i.moon {
    opacity: 0;
}

.menu-bar .bottom-content .toggle-switch {
    position: absolute;
    right: 0;
    height: 100%;
    min-width: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    cursor: pointer;
}
.toggle-switch .switch {
    position: relative;
    height: 22px;
    width: 40px;
    border-radius: 25px;
    background-color: var(--toggle-color);
    transition: var(--tran-05);
}

.switch::before {
    content: "";
    position: absolute;
    height: 15px;
    width: 15px;
    border-radius: 50%;
    top: 50%;
    left: 5px;
    transform: translateY(-50%);
    background-color: var(--sidebar-color);
    transition: var(--tran-04);
}

body.dark .switch::before {
    left: 20px;
}

.home {
    position: absolute;
    top: 0;
    left: 250px;
    height: 100vh;
    width: calc(100% - 250px);
    overflow-y: auto;
    transition: left 0.3s ease, width 0.3s ease;
}

.sidebar.close ~ .home {
    left: 78px;
    width: calc(100% - 78px);
}

.sidebar.close:hover ~ .home {
    left: 250px;
    width: calc(100% - 250px);
}

body.dark .home .text {
    color: var(--text-color);
}

.menu-icon {
    display: none;
}

@@media (max-width: 1100px) {
    .sidebar {
        display: none;
    }

    .sidebar.close {
        display: none;
    }

    .menu-icon {
        display: block;
    }

    .home {
        left: 0;
        width: 100%;
    }

    .sidebar.close ~ .home {
        left: 0;
        width: 100%;
    }
}

/* Mobile responsiveness enhancements */
@@media (max-width: 700px) {
    .about-card {
        width: 98%; /* Increase width on smaller screens */
        height: auto; /* Allow height to adjust based on content */
        min-height: 500px; /* Adjust min-height for mobile */
        padding: 30px 20px; /* Adjust padding for mobile */
    }

    .about-logo {
        width: 100%;
        max-width: 100%;
        height: 200px; /* Smaller height on mobile */
    }

    .about-card .about-title {
        font-size: 28px; /* Smaller font size */
    }

    .about-card .about-description {
        font-size: 16px; /* Smaller font size */
    }

    .about-details {
        grid-template-columns: 1fr; /* Single column on mobile */
        gap: 15px;
    }

    .detail-section h4 {
        font-size: 20px;
    }

    .detail-section p {
        font-size: 14px;
    }
}

@@media (max-width: 480px) {
    .about-card {
        width: 99%; /* Even wider on very small screens */
        padding: 20px 15px; /* Further reduce padding */
    }

    .about-logo {
        height: 150px; /* Even smaller height */
    }

    .about-card .about-title {
        font-size: 24px; /* Even smaller font */
    }

    .about-card .about-description {
        font-size: 14px; /* Smaller font */
    }

    .detail-section h4 {
        font-size: 18px;
    }

    .detail-section p {
        font-size: 12px;
    }
}

::-webkit-scrollbar {
    display: none;
}
</style>