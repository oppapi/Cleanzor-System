@page "/profile"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject CustomAuthStateProvider AuthProvider
@inject IJSRuntime JSRuntime

<div class="page-container">
    <nav class="sidebar @(isSidebarOpen ? "" : "close")">
        <header>
            <div class="image-text">
                <span class="image">
                    <img src="images/CleanzorGreenLogo.png" alt="Cleanzor-Logo">
                </span>

                <div class="text logo-text">
                    <span class="name">Stella Army</span>
                    <span class="profession">Web developer</span>
                </div>
            </div>

            <i class='bx bx-chevron-right toggle' @onclick="ToggleSidebar"></i>
        </header>

        <div class="menu-bar">
            <div class="menu">
                <ul class="menu-links">
                    <li class="nav-link">
                        <a href="/dashboard">
                            <i class='bx bx-home-alt icon'></i>
                            <span class="text nav-text">Dashboard</span>
                        </a>
                    </li>

                    <li class="nav-link">
                        <a href="/profile">
                            <i class='bx bx-bar-chart-alt-2 icon'></i>
                            <span class="text nav-text">Profile</span>
                        </a>
                    </li>

                    <li class="nav-link">
                        <a href="/about">
                            <i class='bx bx-bell icon'></i>
                            <span class="text nav-text">About Us</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="bottom-content">
                <li class="">
                    <a>
                        <i class='bx bx-log-out icon'></i>
                        <span class="text nav-text" @onclick="Signout">Logout</span>
                    </a>
                </li>

                <li class="mode">
                    <div class="sun-moon">
                        <i class='bx bx-moon icon moon'></i>
                        <i class='bx bx-sun icon sun'></i>
                    </div>
                    <span class="mode-text text">@(isDarkMode ? "Light mode" : "Dark mode")</span>

                    <div class="toggle-switch" @onclick="ToggleDarkMode">
                        <span class="switch"></span>
                    </div>
                </li>
            </div>
        </div>
    </nav>
    
    <section class="home">
        <div class="main-content">
            <div class="profile-card">
                <div class="profile-avatar">
                    <img src="images/CleanzorGreenLogo.png" alt="User Avatar" /> @* Placeholder image name *@
                </div>
                
                <h3 class="username">McccNuggets#1069</h3>
                <p class="user-role">Cleanzor User</p>
                
                <div class="profile-details-grid">
                    <div class="detail-column">
                        <div class="detail-row">
                            <span class="detail-label">Last name:</span>
                            <span class="detail-value">DOLORITO</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">First name:</span>
                            <span class="detail-value">MC LLOYD</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Email:</span>
                            <span class="detail-value">email@gmail.com</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Account created at:</span>
                            <span class="detail-value">11 November 2025</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    [Inject] NavigationManager NavManager { get; set; } = default!;

    private bool isSidebarOpen = false;
    private bool isDarkMode = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // No charts or periodic updates needed
    }

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private void OpenSidebar()
    {
        isSidebarOpen = true;
    }

    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        await JSRuntime.InvokeVoidAsync("toggleDarkMode", isDarkMode);
    }

    private async Task Signout()
    {
        NavManager.NavigateTo("/");
    }
}

<script>
    function toggleDarkMode(isDark) {
        if (isDark) {
            document.body.classList.add('dark');
        } else {
            document.body.classList.remove('dark');
        }
    }
</script>

<style>
    @@import url('https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css');

:root {
    --body-color: #e4e9f7;
    --sidebar-color: #fff;
    --primary-color: #dc143c;
    --primary-color-light: #f6f5ff;
    --toggle-color: #ddd;
    --text-color: #707070;

    --tran-02: all 0.2s ease;
    --tran-03: all 0.3s ease;
    --tran-04: all 0.4s ease;
    --tran-05: all 0.5s ease;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    height: 100vh;
    display: grid;
    place-items: center;
    /* Overlay for the lower half of the background image */
    background: 
        linear-gradient(to bottom, transparent 50%, rgba(228, 233, 247, 1) 50%), 
        url("images/BlueGreenBackground.png");
    background-size: cover; 
    font-family: "Montserrat", sans-serif;
    background-color: var(--body-color);
    transition: var(--tran-05);
}

.profile-avatar {
    /* Positioning the avatar relative to the header bar */
    position: absolute;
    top: -60px; /* Pull it up into the header bar area */
    width: 120px;
    height: 120px;
    border-radius: 50%;
    /* White background with a white border to make it pop */
    background-color: var(--sidebar-color); 
    border: 5px solid var(--sidebar-color);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    padding: 5px; 
    z-index: 10; /* Ensure it's above everything */
}

.profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
}

::selection {
    background-color: var(--primary-color);
    color: #fff;
}

body.dark {
    --body-color: #18191a;
    --sidebar-color: #242526;
    --primary-color: #3a3b3c;
    --primary-color-light: #3a3b3c;
    --toggle-color: #fff;
    --text-color: #ccc;
}

body.dark .sidebar li a:hover .icon,
body.dark .sidebar li a:hover .text {
    color: var(--text-color);
}

.page-container {
    height: 100vh;
    width: 100%;
    overflow: hidden;
}

/* -------------------- MAIN CONTENT & PROFILE CARD STYLES -------------------- */

.main-content {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 25px; 
    overflow-y: auto; 
    width: 100%;
    height: 100%;
}

.profile-card {
    width: 85%; 
    max-width: 1000px; /* Reduced max-width to match the image */
    min-height: 400px;
    height: 70%;
    background-color: var(--sidebar-color);
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15); /* Stronger shadow */
    padding: 80px 40px 40px 40px; /* Increased top padding to account for avatar */
    box-sizing: border-box; 
    transition: var(--tran-05);
    color: var(--text-color);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.profile-card h3, .profile-card h3 {
    margin-top: 10px; 
    font-size: 30px;
    font-weight: bolder;
}

.profile-details-grid {
    display: grid;
    gap: 15px;
    width: 100%;
    max-width: 600px;
}

.detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid #eee;
    font-size: 20px;
    text-align: center;
}

.detail-label {
    font-weight: bold;
    color: var(--text-color);
}

.detail-value {
    color: var(--text-color);
}

/* -------------------- END MAIN CONTENT & PROFILE CARD STYLES -------------------- */

.sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100%;
    width: 250px;
    padding: 10px 14px;
    background: var(--sidebar-color);
    transition: var(--tran-05);
    z-index: 100;
}

.sidebar.close {
    width: 88px;
}

.sidebar.close:hover {
    width: 250px;
}

.sidebar.close:hover .text {
    opacity: 1;
}

.sidebar li {
    height: 50px;
    list-style: none;
    display: flex;
    align-items: center;
    margin-top: 10px;
}

.sidebar header .image,
.sidebar .icon {
    min-width: 60px;
    border-radius: 6px;
}

.sidebar .icon {
    min-width: 60px;
    border-radius: 6px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
}

.sidebar .text,
.sidebar .icon {
    color: var(--text-color);
    transition: var(--tran-03);
}

.sidebar .text {
    font-size: 17px;
    font-weight: 500;
    white-space: nowrap;
    opacity: 1;
}
.sidebar.close .text {
    opacity: 0;
}

.sidebar header {
    position: relative;
}

.sidebar header .image-text {
    display: flex;
    align-items: center;
}
.sidebar header .logo-text {
    display: flex;
    flex-direction: column;
}
header .image-text .name {
    margin-top: 2px;
    font-size: 18px;
    font-weight: 600;
}

header .image-text .profession {
    font-size: 16px;
    margin-top: -2px;
    display: block;
}

.sidebar header .image {
    display: flex;
    align-items: center;
    justify-content: center;
}

.sidebar header .image img {
    width: 40px;
    border-radius: 6px;
}

.sidebar header .toggle {
    position: absolute;
    top: 50%;
    right: -30px;
    transform: translateY(-50%) rotate(180deg);
    height: 25px;
    width: 25px;
    background-color: var(--primary-color);
    color: var(--sidebar-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    cursor: pointer;
    transition: var(--tran-05);
}

body.dark .sidebar header .toggle {
    color: var(--text-color);
}

.sidebar.close .toggle {
    transform: translateY(-50%) rotate(0deg);
}

.profile-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background-color: var(--sidebar-color);
    border: 5px solid var(--sidebar-color);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    padding: 5px; /* Inner padding for avatar */
}

@@media (min-width: 1101px) {
    .sidebar header .toggle {
        display: none;
    }
}

.sidebar .menu {
    margin-top: 40px;
}

.sidebar li.search-box {
    border-radius: 6px;
    background-color: var(--primary-color-light);
    cursor: pointer;
    transition: var(--tran-05);
}

.sidebar li.search-box input {
    height: 100%;
    width: 100%;
    outline: none;
    border: none;
    background-color: var(--primary-color-light);
    color: var(--text-color);
    border-radius: 6px;
    font-size: 17px;
    font-weight: 500;
    transition: var(--tran-05);
}

.menu-links {
    padding: 0;
    margin: 0;
    list-style: none;
}

.sidebar li a {
    list-style: none;
    height: 100%;
    background-color: transparent;
    display: flex;
    align-items: center;
    width: 100%;
    border-radius: 6px;
    text-decoration: none;
    transition: var(--tran-03);
}

.sidebar li a:hover {
    background-color: #00a887;
}
.sidebar li a:hover .icon,
.sidebar li a:hover .text {
    color: var(--sidebar-color);
}

.sidebar .menu-bar {
    height: calc(100% - 55px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow-y: scroll;
}
.menu-bar::-webkit-scrollbar {
    display: none;
}
.sidebar .menu-bar .mode {
    border-radius: 6px;
    background-color: var(--primary-color-light);
    position: relative;
    transition: var(--tran-05);
}

.menu-bar .mode .sun-moon {
    height: 50px;
    width: 60px;
}

.mode .sun-moon i {
    position: absolute;
}
.mode .sun-moon i.sun {
    opacity: 0;
}
body.dark .mode .sun-moon i.sun {
    opacity: 1;
}
body.dark .mode .sun-moon i.moon {
    opacity: 0;
}

.menu-bar .bottom-content .toggle-switch {
    position: absolute;
    right: 0;
    height: 100%;
    min-width: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    cursor: pointer;
}
.toggle-switch .switch {
    position: relative;
    height: 22px;
    width: 40px;
    border-radius: 25px;
    background-color: var(--toggle-color);
    transition: var(--tran-05);
}

.switch::before {
    content: "";
    position: absolute;
    height: 15px;
    width: 15px;
    border-radius: 50%;
    top: 50%;
    left: 5px;
    transform: translateY(-50%);
    background-color: var(--sidebar-color);
    transition: var(--tran-04);
}

body.dark .switch::before {
    left: 20px;
}

.home {
    position: absolute;
    top: 0;
    left: 250px;
    height: 100vh;
    width: calc(100% - 250px);
    overflow-y: auto;
    transition: left 0.3s ease, width 0.3s ease;
}

.sidebar.close ~ .home {
    left: 78px;
    width: calc(100% - 78px);
}

.sidebar.close:hover ~ .home {
    left: 250px;
    width: calc(100% - 250px);
}

body.dark .home .text {
    color: var(--text-color);
}

.menu-icon {
    display: none;
}

@@media (max-width: 1100px) {
    .sidebar {
        display: none;
    }

    .sidebar.close {
        display: none;
    }

    .menu-icon {
        display: block;
    }

    .home {
        left: 0;
        width: 100%;
    }

    .sidebar.close ~ .home {
        left: 0;
        width: 100%;
    }
}

/* Mobile responsiveness enhancements */
@@media (max-width: 700px) {
    .profile-card {
        width: 95%; /* Increase width on smaller screens */
        height: auto; /* Allow height to adjust based on content */
        min-height: 300px; /* Reduce min-height for mobile */
        padding: 70px 20px 20px 20px; /* Adjust padding for mobile */
    }

    .profile-avatar {
        width: 100px; /* Smaller avatar on mobile */
        height: 100px;
        top: -50px; /* Adjust position */
    }

    .profile-card h3 {
        font-size: 30px; /* Smaller font size */
        margin-top: 5px;
        font-weight: bolder;
    }

    .profile-details-grid {
        gap: 10px; /* Reduce gap */
        max-width: 100%; /* Full width on mobile */
    }

    .detail-row {
        font-size: 20px; /* Smaller font size */
        padding: 8px 0; /* Reduce padding */
        flex-direction: column; /* Stack label and value vertically */
        align-items: center; /* Align to start */
        gap: 5px; /* Add gap between label and value */
    }

    .detail-label {
        font-weight: bold;
    }

    .detail-value {
        font-weight: normal;
    }
}

@@media (max-width: 480px) {
    .profile-card {
        width: 98%; /* Even wider on very small screens */
        padding: 80px 15px 15px 15px; /* Further reduce padding */
    }

    .profile-avatar {
        width: 80px; /* Even smaller avatar */
        height: 80px;
        top: -40px;
    }

    .profile-card h3 {
        font-size: 30px; /* Even smaller font */
    }

    .detail-row {
        font-size: 20px; /* Smaller font */
    }
}

::-webkit-scrollbar {
    display: none;
}
</style>