@page "/dashiboard"

<div class="page-container">
    <!-- Sidebar Overlay -->
    <div class="overlay @(isSidebarOpen ? "active" : "")" @onclick="ToggleSidebar"></div>

    <!-- Sidebar -->
<nav class="sidebar @(isSidebarOpen ? "open" : "")">
    @* Only show toggle button when sidebar is open *@
    @if (isSidebarOpen)
    {
        <i class='bx bx-chevron-right toggle-btn' @onclick="ToggleSidebar"></i>
    }

    <header class="flex items-center gap-3">
        <div class="text logo-text">
            <span class="name">Stella Army</span>
            <span class="profession">Web Developer</span>
        </div>
    </header>

    <ul class="menu-links">
        <li><a href="#"><i class='bx bx-home-alt icon'></i><span class="text">Dashboard</span></a></li>
        <li><a href="#"><i class='bx bx-bar-chart-alt-2 icon'></i><span class="text">Revenue</span></a></li>
        <li><a href="#"><i class='bx bx-bell icon'></i><span class="text">Notifications</span></a></li>
        <li><a href="#"><i class='bx bx-pie-chart-alt icon'></i><span class="text">Analytics</span></a></li>
        <li><a href="#"><i class='bx bx-heart icon'></i><span class="text">Likes</span></a></li>
        <li><a href="#"><i class='bx bx-wallet icon'></i><span class="text">Wallets</span></a></li>
    </ul>

    <ul class="bottom-content">
        <li><a href="#"><i class='bx bx-log-out icon'></i><span class="text">Logout</span></a></li>
    </ul>
</nav>


    <!-- Header -->
    <div class="header">
        <i class='bx bx-menu menu-icon' @onclick="ToggleSidebar"></i>
        <span>Header</span>
    </div>

    <!-- Content -->
    <div class="info">Information</div>
    <div class="line-graph">Line Graph</div>
    <div class="pie-graph">Pie Graph</div>
</div>

@code {
    private bool isSidebarOpen = false;

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }
}

<style>
@@import url('https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Poppins", sans-serif;
}

/* ---------- PAGE GRID ---------- */
.page-container {
    display: grid;
    height: 100vh;
    width: 100vw;
    gap: 2px;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: 60px auto 2fr;
    overflow: hidden;
}

/* ---------- HEADER ---------- */
.header {
    grid-column: span 6;
    height: 60px;
    background-color: #00A887;
    color: white;
    display: flex;
    align-items: center;
    padding: 0 20px;
    font-size: 1.5rem;
    font-weight: bold;
}

.menu-icon {
    font-size: 26px;
    cursor: pointer;
    margin-right: 15px;
}

/* ---------- INFO + GRAPHS ---------- */
.info {
    grid-column: span 6;
    background-color: #2196F3;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 1.2rem;
    height: 300px;
}

.line-graph {
    grid-column: span 4;
    background-color: #FF9800;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 1.2rem;
    color: white;
}

.pie-graph {
    grid-column: span 2;
    background-color: #9C27B0;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 1.2rem;
    color: white;
}

/* ---------- MOBILE ---------- */
@@media (max-width: 768px) {
    .page-container {
        grid-template-columns: 1fr;
        grid-template-rows: 60px 200px 300px 250px;
        min-height: 100vh;
        overflow-y: auto;
    }

    .header {
        grid-column: span 1;
        height: 60px;
    }

    .info {
        grid-column: span 1;
        height: 200px;
    }

    .line-graph {
        grid-column: span 1;
        height: 300px;
    }

    .pie-graph {
        grid-column: span 1;
        height: 250px;
    }
}

/* ===== Overlay Sidebar ===== */
.sidebar {
    position: fixed;
    top: 0;
    left: -250px;
    height: 100%;
    width: 250px;
    padding: 10px 14px;
    background: #fff;
    transition: left 0.3s ease;
    z-index: 200;
    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.15);
}

.sidebar.open {
    left: 0;
}

/* ===== Overlay ===== */
.overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.3);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    z-index: 150;
}

.overlay.active {
    opacity: 1;
    pointer-events: auto;
}

/* ===== Sidebar Content ===== */
.sidebar header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.sidebar header .image-text {
    display: flex;
    align-items: center;
}

.sidebar header .image img {
    width: 40px;
    border-radius: 6px;
    margin-right: 10px;
}

.sidebar .menu-links, .bottom-content {
    list-style: none;
    padding: 0;
}

.sidebar li {
    margin: 10px 0;
}

.sidebar li a {
    text-decoration: none;
    color: #333;
    display: flex;
    align-items: center;
    padding: 8px;
    border-radius: 6px;
    transition: background 0.3s;
}

.sidebar li a:hover {
    background-color: #00A887;
    color: #fff;
}

.sidebar .icon {
    font-size: 20px;
    width: 30px;
}

/* ===== Floating Toggle Button ===== */
.toggle-btn {
    position: absolute;
    top: 50%;
    right: -15px;
    transform: translateY(-50%) rotate(180deg);
    height: 35px;
    width: 35px;
    background-color: #dc143c;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    cursor: pointer;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
    z-index: 220;
}

.sidebar.open .toggle-btn {
    transform: translateY(-50%) rotate(0deg);
}

.toggle-btn:hover {
    background-color: #b01030;
}

/* Hide scrollbar */
::-webkit-scrollbar {
    display: none;
}
</style>
