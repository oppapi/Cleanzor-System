                    </div>
                </div>

                <div class="small-box text-bg-primary">
                    <div class="inner">
                        <h3>@load</h3>
                        <p>Load</p>
                    </div>
                    <svg
                        class="small-box-icon"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                        aria-hidden="true"
