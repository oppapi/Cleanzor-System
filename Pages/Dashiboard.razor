<script>
const colorPrimary = getComputedStyle(document.documentElement)
    .getPropertyValue("--color-primary")
    .trim();

const colorLabel = getComputedStyle(document.documentElement)
    .getPropertyValue("--color-label")
    .trim();

const fontFamily = getComputedStyle(document.documentElement)
    .getPropertyValue("--font-family")
    .trim();

const defaultOptions = {

    chart: {
        toolbar: {
            show: false
        },
        zoom: {
            enabled: false
        },
        width: '100%',
        height: 180,
        offsetY: 18
    },

    dataLabels: {
        enabled: false
    }

}

let barOptions = {

    ...defaultOptions,

    chart: {
        ...defaultOptions.chart,
        type: "area"
    },

    tooltip: {
        enabled: true,
        style: {
            fontFamily: fontFamily
        },
        y: {
            formatter: value => `${value}K`
        }
    },

    series: [
        {
            name: "Views",
            data: [15, 50, 18, 90, 30, 65]
        }
    ],

    colors: [colorPrimary],

    fill: {
        type: "gradient",
        gradient: {
            type: "vertical",
            opacityFrom: 1,
            opacityTo: 0,
            stops: [0, 100],
            colorStops: [
                {
                    offset: 0,
                    opacity: .2,
                    color: "#ffffff"
                },
                {
                    offset: 100,
                    opacity: 0,
                    color: "#ffffff"
                }
            ]
        }
    },

    stroke: { colors: [colorPrimary], lineCap: "round" },

    grid: {
        borderColor: "rgba(0, 0, 0, 0)",
        padding: {
            top: -30,
            right: 0,
            bottom: -8,
            left: 12
        }
    },

    markers: {
        strokeColors: colorPrimary
    },

    yaxis: {
        show: false
    },

    xaxis: {

        labels: {
            show: true,
            floating: true,
            style: {
                colors: colorLabel,
                fontFamily: fontFamily
            }
        },

        axisBorder: {
            show: false
        },

        crosshairs: {
            show: false
        },

        categories: ["Jan", "Mar", "May", "Jul", "Sep", "Nov"]

    }

};

let chart = new ApexCharts(
    document.querySelector(".area-chart"), barOptions
);

chart.render();
</script>
@code {
    private string status = "Cleaning";
    private int load = 69;
    private string schedule = "10:30 AM";
    private string battery = "Online";
    private int wheelSpeed = 59;
    private int sweeperSpeed = 45;
    private bool isSidebarOpen = false;

    private bool isDarkMode = false;

    @inject IJSRuntime? JSRuntime

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private void OpenSidebar()
    {
        isSidebarOpen = true;
    }

    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        await JSRuntime!.InvokeVoidAsync("toggleDarkMode", isDarkMode);
    }
}

<script>
    function toggleDarkMode(isDark) {
        if (isDark) {
            document.body.classList.add('dark');
        } else {
            document.body.classList.remove('dark');
        }
    }
</script>

<style>
    @@import url('https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css');

:root {
    --color-primary: #44d4fd;
    --color-label: #a7a7a7;
    --color-text: #e2dede;
    --font-family: "Montserrat";
}

* {
    margin: 0;
    padding: 0;
}


/* Body styles - Centers content and sets background */
body {
    height: 100vh;  /* Full viewport height - adjust if needed for different layouts */
    display: grid;
    place-items: center;  /* Centers the content - change to 'start' or 'end' for different alignment */
    background: var(--color-primary);  /* Uses CSS variable for primary color - modify --color-primary in :root if needed */
    font-family: var(--font-family);  /* Uses CSS variable for font - adjust --font-family in :root */
}

/* Card container for the chart - made responsive to fit grid */
.card {
    position: relative;
    width: 100%;  /* Changed from fixed 360px to 100% for responsiveness - adjust to a percentage or fixed value if needed */
    max-width: 100%;  /* Prevents overflow in smaller containers - can be set to a specific max-width like 400px */
    padding: 20px;  /* Reduced from 30px for better fit - increase/decrease for more/less spacing inside */
    border-radius: 10px;  /* Rounded corners - adjust for sharper or rounder edges */
    background: #1b1b1b;  /* Dark background - change to a lighter color like #ffffff for light theme */
    box-shadow: 0 50px 100px rgba(0, 0, 0, .08);  /* Shadow effect - adjust blur or opacity for subtlety */
    display: flex;  /* Added flex for centering content */
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 250px;  /* Minimum height to ensure content fits - increase for taller cards */
    overflow: hidden;  /* Prevents content from spilling out - remove if content should be visible outside */
}

/* Card title - optional if not used in HTML */
.card h2 {
    color: #f9f9f9;  /* Light text color - change to #000000 for dark theme */
    font-size: 26px;  /* Title size - adjust for larger/smaller text */
    font-weight: 500;  /* Font weight - increase to 700 for bolder */
    letter-spacing: .5px;  /* Letter spacing - adjust for tighter/looser */
    margin: 0 0 2px;  /* Margin below title - increase for more space */
}

/* Card description - optional if not used in HTML */
.card p {
    color: var(--color-text);  /* Uses CSS variable - adjust --color-text in :root */
    font-size: 14px;  /* Description size - adjust for readability */
    margin: 0 0 16px;  /* Margin below description - increase for more space */
}

/* Area chart container */
.card .area-chart {
    position: relative;
    width: 100%;  /* Full width of card - adjust to a percentage if needed */
    height: 180px;  /* Fixed height for chart - increase for taller charts */
}

/* Grid background for chart */
.card .area-chart .grid {
    position: absolute;
    z-index: 0;  /* Behind chart - no need to adjust */
    top: 0;  /* Starts at top - no need to adjust */
    left: 0;  /* Starts at left - no need to adjust */
    width: 100%;  /* Full width - no need to adjust */
    height: 80%;  /* Height of grid - adjust percentage for more/less coverage */
    background-image: repeating-linear-gradient(
        to right,
        transparent 0% 3%,  /* Transparent start - adjust percentages for grid spacing */
        #f9f9f9 3% 3.5%,    /* Grid line color and width - change #f9f9f9 for different color */
        transparent 3% 18.65%  /* Transparent end - adjust for spacing */
    );
}

/* Gradient overlay on grid */
.card .area-chart .grid::after {
    content: '';
    position: inherit;  /* Inherits position - no need to adjust */
    z-index: 1;  /* Above grid, below chart - no need to adjust */
    top: inherit;  /* Inherits top - no need to adjust */
    bottom: inherit;  /* Inherits bottom - no need to adjust */
    width: inherit;  /* Inherits width - no need to adjust */
    height: 100%;  /* Full height - no need to adjust */
    background: linear-gradient(
        180deg,  /* Direction of gradient - change to 90deg for horizontal */
        rgba(27, 27, 27, 1),    /* Top color - adjust RGBA for opacity/color */
        rgba(27, 27, 27, .9),   /* Middle color - adjust for fade */
        rgba(27, 27, 27, 1)     /* Bottom color - adjust RGBA */
    );
}


body .apexcharts-tooltip.apexcharts-theme-light {
    color: var(--color-text);
    background: rgba(0, 0, 0, .5);
    backdrop-filter: blur(10px);
    box-shadow: none;
    padding: 8px 6px 4px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .5px;
    border: 0;
}

.apexcharts-tooltip-title,
.apexcharts-xaxistooltip-bottom.apexcharts-theme-light {
    display: none;
