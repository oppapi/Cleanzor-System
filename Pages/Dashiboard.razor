            <div class="small-box-footer" style="height: 7px;"></div>
        </div>

        <!-- Schedule Box -->
        <div class="small-box" style="background-color: #4db6ac; color: #ffffff;">
            <div class="inner">
                <h3>@(schedule)</h3>
                <p>???</p>
            </div>
            <img src="images/time.svg" alt="Schedule Icon" class="small-box-icon" style="width: 80px; height: 80px; filter: brightness(0) invert(1);" />
            <div class="small-box-footer" style="height: 7px;"></div>
        </div>

        <!-- Battery Box -->
        <div class="small-box" style="background-color: #4db6ac; color: #ffffff;">
            <div class="inner">
                <h3>@(battery)</h3>
                <p>Battery</p>
            </div>
            <img src="images/battery.svg" alt="Battery Icon" class="small-box-icon" style="width: 80px; height: 80px; filter: brightness(0) invert(1);" />
            <div class="small-box-footer" style="height: 7px;"></div>
        </div>

        <!-- Wheel Speed Box -->
        <div class="small-box" style="background-color: #4db6ac; color: #ffffff;">
            <div class="inner">
                <h3>@(wheelSpeed + "%")</h3>
                <p>Wheel Speed</p>
            </div>
            <img src="images/wheel.svg" alt="Wheel Icon" class="small-box-icon" style="width: 80px; height: 80px; filter: brightness(0) invert(1);" />
            <div class="small-box-footer" style="height: 7px;"></div>
        </div>

        <!-- Sweeper Speed Box -->
        <div class="small-box" style="background-color: #4db6ac; color: #ffffff;">
            <div class="inner">
                <h3>@(sweeperSpeed + "%")</h3>
                <p>Sweeper Speed</p>
            </div>
            <img src="images/sweeper.svg" alt="Sweeper Icon" class="small-box-icon" style="width: 80px; height: 80px; filter: brightness(0) invert(1);" />
            <div class="small-box-footer" style="height: 7px;"></div>
        </div>

        </div>
            <div class="card">
                <div class="area-chart">
                    <div class="grid"></div>
                </div>
            </div>
            <div class="pie-graph" id="pieChartContainer"></div>
            </div>
            
            </div>
        </section>
    </div>


    @code {
    [Inject] NavigationManager NavManager { get; set; } = default!;
    private string status = "Cleaning";
    private int load = 69;
    private string schedule = "10:30 AM";
    private string battery = "Online";
    private int wheelSpeed = 59;
    private int sweeperSpeed = 45;
    private bool isSidebarOpen = false;

    private bool isDarkMode = false;
    private bool chartsLoaded = false; 

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !chartsLoaded)
        {
            await LoadCharts();
            chartsLoaded = true;
            await JSRuntime.InvokeVoidAsync("listenToSensorData");
            await PeriodicUpdate();
        }
    }

    private async Task LoadCharts()
    {
        await JSRuntime.InvokeVoidAsync("loadCharts");
    }
    
    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private void OpenSidebar()
    {
        isSidebarOpen = true;
    }

    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        await JSRuntime.InvokeVoidAsync("toggleDarkMode", isDarkMode);
    }
private async Task Signout()
{
    await JSRuntime.InvokeVoidAsync("signOutFirebase");
    NavManager.NavigateTo("/");
}

private async Task PeriodicUpdate()
{
    while (true)
    {
        try
        {
            var dataJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "robotData");

            if (!string.IsNullOrEmpty(dataJson))
            {
                var parsed = System.Text.Json.JsonDocument.Parse(dataJson).RootElement;

                status = parsed.TryGetProperty("status", out var s) ? s.GetString() ?? status : status;
                battery = parsed.TryGetProperty("battery", out var b) ? b.GetString() ?? battery : battery;
                schedule = parsed.TryGetProperty("schedule", out var sch) ? sch.GetString() ?? schedule : schedule;

                if (parsed.TryGetProperty("load", out var l) && l.TryGetInt32(out var loadVal))
                    load = loadVal;

                if (parsed.TryGetProperty("wheelSpeed", out var ws) && ws.TryGetInt32(out var wheelVal))
                    wheelSpeed = wheelVal;

                if (parsed.TryGetProperty("sweeperSpeed", out var ss) && ss.TryGetInt32(out var sweepVal))
                    sweeperSpeed = sweepVal;

                await InvokeAsync(StateHasChanged);
            }
            else
            {
                Console.WriteLine("⚠️ No robotData found in localStorage.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"⚠️ Error reading sensor data: {ex.Message}");
        }

        await Task.Delay(2000);
    }
}
}

    <script>
        function toggleDarkMode(isDark) {
            if (isDark) {
                document.body.classList.add('dark');
            } else {
                document.body.classList.remove('dark');
            }
        }
    </script>

